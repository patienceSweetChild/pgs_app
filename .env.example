# Copy to `.env.local` (repo root), then run: npm run sync:env
# Never commit `.env.local` — it is gitignored.

# --- Supabase (required) ---
# Hosted: https://supabase.com/dashboard/project/<ref>/settings/api
# Local CLI: run `npx supabase status` after `npx supabase start`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Legacy name also works: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Multi-app surface URLs (local dev) ---
NEXT_PUBLIC_WEB_SITE_URL=http://localhost:3000
NEXT_PUBLIC_OPS_SITE_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_SITE_URL=http://localhost:3002
NEXT_PUBLIC_CMS_SITE_URL=http://localhost:3003

# Per-app only (set in Vercel per deployable):
# NEXT_PUBLIC_PGS_SURFACE=web|ops|admin|cms
# NEXT_PUBLIC_SITE_URL=<this app's canonical URL>

# --- Optional ---
NEXT_PUBLIC_ENABLE_DEV_ROLE_SWITCHER=false
GROQ_API_KEY=
PGS_AI_MODEL=qwen/qwen3-32b

# Do NOT set unless you want shared SSO across subdomains:
# PGS_COOKIE_DOMAIN=
